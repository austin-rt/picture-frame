# Frame configuration — copy to frame.env and customize per deployment.
# All scripts source this file. On the device, lives at ~/frame.env

# --- Identity ---
FRAME_NAME="grandma"

# --- Display ---
FRAME_WIDTH=1280
FRAME_HEIGHT=800
IMAGE_QUALITY=4          # ffmpeg -q:v (2=best, 6=smallest, 4=good balance)
SLIDESHOW_INTERVAL=30    # seconds between photo transitions
FADE_DURATION=1500       # crossfade duration in ms

# --- Sync ---
RCLONE_REMOTES="drive:PhotoFrame"   # space-separated rclone remotes
SYNC_INTERVAL=1800                   # seconds between sync cycles (30 min)
MAX_BACKOFF=7200                     # max backoff on repeated failures (2 hr)

# --- Paths (defaults work for Termux, override for local testing) ---
FRAME_DATA_DIR="$HOME/frame-data"
RCLONE_CONF="$HOME/.config/rclone/rclone.conf"

# --- Network ---
HTTP_PORT=8080
